# ==============================================================================
#  Portfolio Backend — Environment Variables (TEMPLATE)
# ------------------------------------------------------------------------------
#  Copy this file to `.env` and fill in the real values.
#      cp .env.example .env
#  Never commit the real `.env` — it is already listed in .gitignore.
# ==============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
# Node environment: "development" | "production"
NODE_ENV=development
# Port the API listens on. On macOS, port 5000 is often taken by the AirPlay
# Receiver — use 5001 (or disable AirPlay Receiver in System Settings).
PORT=5001

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Prisma connection string. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For a hosted DB (Neon, Supabase, Railway…), paste the URL they give you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public portfolio origin used for seeded project screenshots.
PORTFOLIO_SITE_URL=https://amdad-dev.vercel.app

# ─── Sign-up / Login gate ─────────────────────────────────────────────────────
# Shared secret that must be sent with register & login requests (authSecret).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGN_UP_SECRET=replace_with_a_long_random_string

# ─── Admin account (seeded into the DB by `npm run seed`) ─────────────────────
# The register endpoint always creates USER-role accounts, so the only way to
# get an ADMIN account (required by the dashboard) is prisma/seed.ts, which
# reads these three values and upserts an ADMIN user.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── JWT (access + refresh tokens) ────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
EXPIRES_IN=1d
# NOTE: the code reads these EXACT (misspelled) names — keep "TOEKN".
REFRESH_TOEKN_SECRET=replace_with_a_long_random_string
REFRESH_TOEKN_EXPIRES_IN=30d

# ─── Reset password ───────────────────────────────────────────────────────────
RESET_PASS_TOKEN=replace_with_a_long_random_string
RESET_PASS_TOKEN_EXPIRES_IN=15m
RESET_PASSWORD_LINK=http://localhost:3001/reset-password

# ─── Cloudinary (image / file uploads) ────────────────────────────────────────
# From your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email / SMTP (Gmail, used by the contact form) ───────────────────────────
# EMAIL_USER + EMAIL_PASS are the ones actually used by nodemailer.
# For Gmail, EMAIL_PASS must be an "App Password" (not your normal password):
#   https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
# The three below are read into config for legacy/compat; set them the same.
EMAIL=your.email@gmail.com
APP_PASSWORD=your_gmail_app_password
OWNER_EMAIL=your.email@gmail.com

# ─── AI chat assistant (Google Gemini — free tier) ────────────────────────────
# FREE API key (no billing) from https://aistudio.google.com/apikey  (starts with AIza...)
GEMINI_API_KEY=AIza_your_free_key
# Free chat model: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.0-flash

# ─── Telegram DM forwarding (chat "contact me" action) ────────────────────────
# Create a bot with @BotFather -> token; then /getUpdates -> your chat id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
